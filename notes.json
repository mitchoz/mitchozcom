    {
      "posts": [
        {
          "id": "2089433805220151614",
          "url": "https://x.com/mitch0z/status/2089433805220151614",
          "date": "2026-08-17T19:26:53Z",
          "text": "AI movies no longer look like AI.\n\nIntroducing MIRA, a new original AI demo series.\nEpisode 1, made entirely with LetzAI and Seedance 2.5.",
          "likes": 782,
          "replies": 50,
          "photos": [],
          "video": "https://pbs.twimg.com/amplify_video_thumb/2089421505612414977/img/JRnj87cPWTBVTwc5.jpg",
          "quote": {
            "user": "mitch0z",
            "url": "https://x.com/mitch0z/status/2089066811404730802",
            "text": "Filmmaking is at a crossroads.\n\nAI Movies and AI VFX are now basically indistinguishable from traditional films.\n\nYet, modern filmmakers are forced to think in terms of \"hooks\", \"attention spans\", and \"retention rates\" to catch audiences.\n\nThere should be another way."
          }
        },
        {
          "id": "2091905048364146988",
          "url": "https://x.com/mitch0z/status/2091905048364146988",
          "date": "2026-08-24T15:06:43Z",
          "text": "MAKING OF MIRA",
          "likes": 2066,
          "replies": 44,
          "photos": [],
          "video": "https://pbs.twimg.com/amplify_video_thumb/2091903604810563584/img/AXMHp3N_64wbEB3Q.jpg",
          "quote": {
            "user": "mitch0z",
            "url": "https://x.com/mitch0z/status/2089433805220151614",
            "text": "AI movies no longer look like AI.\n\nIntroducing MIRA, a new original AI demo series.\nEpisode 1, made entirely with LetzAI and Seedance 2.5."
          }
        }
